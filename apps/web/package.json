{
  "name": "@vreal/dsh-web-frontend",
  "description": "Web application entry: vite build over the @vreal/dsh-client-web shell library; dist/ served by apps/cli's dsh web",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderbyte520/DSH.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir"
  },
  "license": "MIT",
  "devDependencies": {
    "@vreal/cordis-plugin-group": "workspace:^",
    "@vreal/dsh-client-modules": "workspace:^",
    "@vreal/dsh-client-ui-primitives": "workspace:^",
    "@vreal/dsh-client-ui-slots": "workspace:^",
    "@vreal/dsh-client-web": "workspace:^",
    "@vreal/dsh-cmdline": "workspace:^",
    "@vreal/dsh-pwsh-local": "workspace:^",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "fflate": "^0.8.2"
  }
}
