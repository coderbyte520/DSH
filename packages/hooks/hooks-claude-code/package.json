{
  "name": "@vreal/dsh-hooks-claude-code",
  "description": "Bridge plugin: run a Claude Code hooks.json / settings hook config on the Vreal interception seams",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderbyte520/DSH.git",
    "directory": "packages/hooks/hooks-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vreal/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@vreal/dsh-agent": "workspace:^",
    "@vreal/dsh-hook-protocol": "workspace:^",
    "@vreal/dsh-invariants": "workspace:^",
    "@vreal/dsh-llm": "workspace:^",
    "@vreal/dsh-session": "workspace:^",
    "@vreal/dsh-session-persistence": "workspace:^",
    "@vreal/dsh-subagent": "workspace:^",
    "@vreal/dsh-tools": "workspace:^",
    "@vreal/cordis": "workspace:^"
  },
  "devDependencies": {
    "@vreal/dsh-agent": "workspace:^",
    "@vreal/dsh-agent-loop": "workspace:^",
    "@vreal/dsh-agent-loop-testkit": "workspace:^",
    "@vreal/dsh-shell": "workspace:^",
    "@vreal/dsh-bash-local": "workspace:^",
    "@vreal/dsh-subprocess-local": "workspace:^",
    "@vreal/dsh-hook-protocol": "workspace:^",
    "@vreal/dsh-invariants": "workspace:^",
    "@vreal/dsh-llm": "workspace:^",
    "@vreal/dsh-session": "workspace:^",
    "@vreal/dsh-session-persistence": "workspace:^",
    "@vreal/dsh-session-persistence-jsonl": "workspace:^",
    "@vreal/dsh-subagent": "workspace:^",
    "@vreal/dsh-tools": "workspace:^",
    "@vreal/cordis": "workspace:^"
  }
}
