{
  "name": "@vreal/dsh-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderbyte520/DSH.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@vreal/dsh-client-connection",
        "@vreal/dsh-typert-registry",
        "@vreal/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "immer": "^10.1.1",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@vreal/cordis": "workspace:^",
    "@vreal/dsh-api-remotes": "workspace:^",
    "@vreal/dsh-invariants": "workspace:^",
    "@vreal/dsh-typert-protocol": "workspace:^",
    "@vreal/dsh-typert-registry": "workspace:^",
    "@vreal/dsh-agent": "workspace:^",
    "@vreal/dsh-attachment": "workspace:^",
    "@vreal/dsh-client-connection": "workspace:^",
    "@vreal/dsh-commands": "workspace:^",
    "@vreal/dsh-host-apiproxy": "workspace:^",
    "@vreal/dsh-llm": "workspace:^",
    "@vreal/dsh-llm-retry": "workspace:^",
    "@vreal/dsh-session": "workspace:^",
    "@vreal/dsh-session-projection": "workspace:^",
    "@vreal/dsh-session-title": "workspace:^",
    "@vreal/dsh-tools": "workspace:^"
  },
  "devDependencies": {
    "@vreal/cordis": "workspace:^",
    "@vreal/dsh-api-remotes": "workspace:^",
    "@vreal/dsh-invariants": "workspace:^",
    "@vreal/dsh-timeout": "workspace:^",
    "@vreal/dsh-typert-protocol": "workspace:^",
    "@vreal/dsh-typert-registry": "workspace:^",
    "@types/react": "~18.3.1",
    "@vreal/dsh-client-ui-slots": "workspace:^",
    "react": "^18.2.0",
    "@vreal/dsh-agent": "workspace:^",
    "@vreal/dsh-attachment": "workspace:^",
    "@vreal/dsh-client-connection": "workspace:^",
    "@vreal/dsh-commands": "workspace:^",
    "@vreal/dsh-host-apiproxy": "workspace:^",
    "@vreal/dsh-llm": "workspace:^",
    "@vreal/dsh-llm-retry": "workspace:^",
    "@vreal/dsh-session": "workspace:^",
    "@vreal/dsh-session-projection": "workspace:^",
    "@vreal/dsh-session-title": "workspace:^",
    "@vreal/dsh-tools": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
